# 写译笔记本服务端环境变量模板
# 部署时复制为 app.env 并填入真实值；真实 app.env 不入库
PORT=80
# MySQL 数据库连接（characterEncoding 必须用 Java 编码名 UTF-8，不是 utf8mb4）
COMPOSITION_DB_URL=jdbc:mysql://localhost:3306/fanwenjia?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&useUnicode=true
COMPOSITION_DB_USERNAME=fanwenjia
COMPOSITION_DB_PASSWORD=CHANGE_ME
# 163 邮箱 SMTP（密码填客户端授权码，不是邮箱登录密码）
COMPOSITION_MAIL_HOST=smtp.163.com
COMPOSITION_MAIL_PORT=465
COMPOSITION_MAIL_USERNAME=VocabNote@163.com
COMPOSITION_MAIL_PASSWORD=CHANGE_ME
# 翻译 API（OpenAI 兼容）
TRANSLATION_API_KEY=CHANGE_ME
TRANSLATION_BASE_URL=https://taotoken.net/api/v1
TRANSLATION_MODEL=deepseek-v4-flash
TRANSLATION_TEMPERATURE=0
TRANSLATION_STRUCTURED_OUTPUT=true
TRANSLATION_DISABLE_THINKING=true
